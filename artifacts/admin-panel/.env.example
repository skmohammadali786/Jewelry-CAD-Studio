# Copy this to .env for local development
# On Vercel, set these in your project's Environment Variables settings

# Required: Full URL of your deployed API server on Vercel
# Example: https://your-api-project.vercel.app
# Leave empty for local development (uses same-origin proxy)
VITE_API_BASE_URL=

# Set automatically by Vercel — do not set manually
BASE_PATH=/
PORT=3000

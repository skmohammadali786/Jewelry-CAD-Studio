# Copy this to .env for local development
# On Vercel, set these in your project's Environment Variables settings

# Required: PostgreSQL connection string
# - Local: postgresql://user:password@localhost:5432/dbname
# - Vercel/Neon: provided automatically when you add Vercel Postgres integration
DATABASE_URL=postgresql://user:password@localhost:5432/ajcad

# Required: Secret key for signing JWT tokens (use a long random string)
SESSION_SECRET=replace-with-a-very-long-random-secret-key

# Required: Admin panel login password
ADMIN_PASSWORD=AmirulCAD@2025

# Optional: Comma-separated list of allowed frontend origins (leave empty in dev)
# Example: https://your-portfolio.vercel.app,https://your-admin.vercel.app
ALLOWED_ORIGINS=

# Set automatically by Vercel — do not set manually
PORT=8080
NODE_ENV=production
